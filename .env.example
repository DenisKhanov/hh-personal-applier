# HH Personal Applier local configuration.
#
# Usage:
# 1. Copy this file to `.env`.
# 2. Replace all placeholder values wrapped in `<...>`.
# 3. Keep `.env` local. Do not commit real secrets.

# Backend listen address.
# Hard safety rule: the backend must be reachable only from this machine.
# Current validation accepts only APP_BIND=127.0.0.1 and APP_PORT=8080.
APP_BIND=127.0.0.1
APP_PORT=8080

# Local timezone for daily counters, reports, and scheduled ticks.
# Use an IANA timezone name, for example: Europe/Moscow, Europe/Berlin, UTC.
APP_TIMEZONE=Europe/Moscow

# Optional verbose backend logs.
# Set to true only while debugging local startup or API behavior.
APP_DEBUG=false

# Shared secret required by every backend API request in X-Local-Secret.
# Generate a unique value with:
#   openssl rand -base64 32
# Then paste the same value into the extension popup/bootstrap settings.
# Minimum length enforced by backend: 32 characters.
LOCAL_SHARED_SECRET=<generate with: openssl rand -base64 32>

# PostgreSQL connection string.
# The default matches docker-compose.yml:
#   user: postgres
#   password: postgres
#   database: hh_personal
#   host: 127.0.0.1
#   port: 5432
# Keep sslmode=disable for local Docker Postgres.
DATABASE_DSN=postgres://postgres:postgres@127.0.0.1:5432/hh_personal?sslmode=disable

# Telegram bot used for outbound notifications and cover-letter approval.
# TELEGRAM_BOT_TOKEN comes from @BotFather.
# TELEGRAM_OWNER_CHAT_ID must be your numeric chat id, not @username.
# Only this chat id is allowed to approve cover letters.
TELEGRAM_BOT_TOKEN=<token from @BotFather>
TELEGRAM_OWNER_CHAT_ID=<your numeric chat id>

# LLM provider for cover letters.
# Phase 1 supports Groq as the real provider. The API key is used only by
# the Go backend and must never be copied into the Chrome extension.
# If Groq rate-limits or fails, letter-required vacancies are skipped by design.
LLM_PROVIDER=groq
LLM_API_KEY=<groq api key>
LLM_MODEL=llama-3.3-70b-versatile

# Apply limits.
# DEFAULT_* values are used for a new run unless the owner changes settings.
# MAX_* values cap what the popup/API may allow.
# Backend validation:
#   1 <= DEFAULT_DAILY_LIMIT <= MAX_DAILY_LIMIT <= 200
#   1 <= DEFAULT_RUN_LIMIT <= MAX_RUN_LIMIT <= 100
DEFAULT_DAILY_LIMIT=100
DEFAULT_RUN_LIMIT=25
MAX_DAILY_LIMIT=200
MAX_RUN_LIMIT=100

# Delay between two "Откликнуться" clicks, in seconds.
# The extension background worker picks a random value inside this range.
# Backend validation: 5 <= min <= max <= 180.
DEFAULT_PACE_MIN_SECONDS=6
DEFAULT_PACE_MAX_SECONDS=14

# Cover-letter approval time-to-live in hours.
# If approval is not received before expiry, the vacancy is not submitted
# automatically and is recorded for manual handling/skipping.
# Backend validation: value must be >= 1.
COVER_LETTER_TTL_HOURS=1
