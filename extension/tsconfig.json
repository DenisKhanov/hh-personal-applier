{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["chrome"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "build.mjs", "eslint.config.mjs"]
}
